<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PenPressureProfiler</RootNamespace>
    <AssemblyName>PenPressureProfiler</AssemblyName>
    <!-- Shown in the About dialog. Keep roughly in sync with the release tag. -->
    <Version>1.26.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"               Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop"       Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="System.IO.Ports"        Version="11.0.0"  />
    <PackageReference Include="ScottPlot.Avalonia"     Version="5.1.59"  />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="WinPenKit">
      <HintPath>..\libs\WinPenKit\main-e5a7f61\WinPenKit.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WinPenKit.Avalonia">
      <HintPath>..\libs\WinPenKit\main-e5a7f61\WinPenKit.Avalonia.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
